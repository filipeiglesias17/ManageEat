# Copia este ficheiro para .env.local e preenche os valores.
# Os valores do Supabase local saem de:  npm run db:status

# ── Frontend (expostas no browser via Vite) ──────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Scripts de terminal (seed, migração, backups) ────────────────────────
# NUNCA exponhas a service_role no browser — só em scripts locais.
SUPABASE_SERVICE_ROLE_KEY=

# ── Opcionais ────────────────────────────────────────────────────────────
# Password das contas criadas pelo seed (default: manageeat2026!)
SEED_PASSWORD=
# Password usada pelo audit RLS (default: igual ao seed)
AUDIT_PASSWORD=
# Host/IP fixo da LAN para a app móvel (senão é descoberto automaticamente)
VITE_LOCAL_NETWORK_HOST=
