{
  "name": "manage-eat",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Gestão de restaurante on-premise (POS): à la carte e rodízio, QR de mesa, turnos e relatórios. React + Vite + Capacitor sobre Supabase local.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "launcher:start": "node scripts/launcher/manage-eat.mjs start",
    "launcher:stop": "node scripts/launcher/manage-eat.mjs stop",
    "launcher:status": "node scripts/launcher/manage-eat.mjs status",
    "launcher:shortcuts": "node scripts/launcher/manage-eat.mjs shortcuts",
    "launcher:autostart": "node scripts/launcher/manage-eat.mjs autostart --install",
    "launcher:autostart:off": "node scripts/launcher/manage-eat.mjs autostart --uninstall",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "eslint . && tsc -b && vitest run",
    "gate:release": "eslint . && tsc -b && vitest run && vite build",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "gate:rules": "npx tsx supabase/audit.ts",
    "attack:pentest": "npx tsx scripts/attack/pentest.ts",
    "attack:stress": "npx tsx scripts/attack/stress.ts",
    "attack:all": "npm run attack:pentest; npm run attack:stress",
    "preview": "vite preview",
    "postinstall": "node scripts/fix-supabase-cli.mjs",
    "setup:https": "npx tsx scripts/setup-https.ts",
    "tls:proxy": "npx tsx scripts/tls-proxy.ts",
    "db:start": "npx tsx scripts/db-backup.ts --auto --reason pre-start && npx supabase start && npx supabase migration up --local",
    "db:stop": "npx supabase stop",
    "db:migrate": "npx tsx scripts/db-backup.ts --auto --reason pre-migrate && npx supabase migration up --local",
    "db:reset": "npx tsx scripts/db-reset-guard.ts",
    "db:reset:force": "npx tsx scripts/db-reset-guard.ts --force",
    "db:status": "npx supabase status",
    "db:backup": "npx tsx scripts/db-backup.ts",
    "db:backup:offsite": "npx tsx scripts/db-backup-offsite.ts",
    "db:restore": "npx tsx scripts/db-restore.ts",
    "db:backups": "npx tsx scripts/db-restore.ts --list",
    "db:schedule:install": "npx tsx scripts/install-backup-schedule.ts",
    "db:schedule:uninstall": "npx tsx scripts/install-backup-schedule.ts --uninstall",
    "seed": "npx tsx scripts/seed.ts",
    "ota:publish": "npm run build && npx tsx scripts/ota-publish.ts",
    "icons:generate": "node scripts/generate-assets.js",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-updater": "^8.49.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^7.18.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/cli": "^8.4.1",
    "@capgo/cli": "^8.19.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "supabase": "^2.113.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "11.1.1"
  }
}
